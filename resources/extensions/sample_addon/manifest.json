{
  "manifest_version": 3,
  "name": "SB Sample Addon",
  "version": "1.0.0",
  "description": "Sample add-on used by sbtest. Marks pages and offers a popup.",
  "action": {"default_title": "SB Sample Addon", "default_popup": "popup.html"},
  "permissions": ["storage"],
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["content.js"], "run_at": "document_end"}],
  "options_page": "options.html"
}

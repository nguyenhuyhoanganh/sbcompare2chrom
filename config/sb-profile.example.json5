// Downstream browser profile.
//
// This is the half of the analysis Chromium cannot tell you: which parts of
// the tree YOUR fork actually depends on.  The quality of the "Must fix"
// bucket is a direct function of how honest this file is.
//
// Everything below is illustrative.  Replace the paths, symbols and areas
// with your real fork's inventory before trusting the output.
{
  name: "Samsung Internet",
  platform: "android",          // whose default states matter
  chromium_base: "139.0.7258.155",

  // ---------------------------------------------------------------------
  // Evidence sources.  Use whichever you have; they combine.
  // ---------------------------------------------------------------------

  // 1. A directory of .patch / .diff files -- the usual shape of a vendor
  //    fork.  Both the touched paths and the identifiers inside the hunks
  //    are extracted, and the identifiers are what drive scoring.
  patch_dirs: ["../examples/demo-patches"],

  // 2. A full source fork tracked in git.  Resolves via
  //    `git diff --name-only <upstream_ref>`.
  // git: { repo: "/work/sbrowser/src", upstream_ref: "139.0.7258.155" },

  // 3. A hand-maintained list, for teams that track ownership in a doc.
  //    A trailing slash (or a name with no extension) means "prefix".
  modified_paths: [
    "content/public/common/content_features.cc",
    "third_party/blink/renderer/modules/mediastream/",
  ],
  // modified_paths_file: "owned-paths.txt",

  // 4. Your own (non-Chromium) source, scanned for references to Chromium
  //    feature names, switches and prefs.  This catches code that depends on
  //    a feature without patching the file that declares it.
  // source_roots: ["/work/sbrowser/sbrowser_chrome"],

  // 5. Symbols you know you depend on, regardless of the above.
  symbols: [
    "BackForwardCache",
    "kBackForwardCache",
    "ServiceWorkerAutoPreload",
    "PaymentRequest",
  ],

  // ---------------------------------------------------------------------
  // How to recognise our own code inside the merged tree.
  //
  // A fork of this shape does not overwrite Chromium. It merges the new
  // Chromium in whole, keeps its own implementation beside it, and picks
  // between them at build time:
  //
  //     #if defined(SBROWSER_CUSTOM_DOWNLOADS)
  //       ... ours, which is what actually ships ...
  //     #else
  //       ... Chromium's, untouched since the merge ...
  //     #endif
  //
  // Both are present, so comparing values finds nothing: upstream's branch
  // really is identical to upstream. The branch that runs is the other one.
  // That is how "we match M148" can be true and misleading at once.
  //
  // These markers are what `chromedrift provenance --profile` uses to tell a
  // shadowed declaration from an untouched one. Names differ per vendor and
  // are never guessed -- leave this out and the shadow analysis is skipped
  // rather than producing invented matches.
  // ---------------------------------------------------------------------
  vendor_markers: {
    // Build flags naming our code, matched as substrings, case-insensitive.
    macros: ["SBROWSER", "SAMSUNG", "S_TERRACE"],
    // Prefixes on our own feature and variable names.
    symbol_prefixes: ["kSbrowser", "kSamsung"],
    // Directories that are ours outright.
    path_markers: ["sbrowser/", "samsung/"],
  },

  // ---------------------------------------------------------------------
  // Owned areas.  These do three jobs at once: they boost the impact score,
  // they group findings into coherent batches for the model, and they route
  // the report to the team that owns each part.
  //
  // `kind` matters more than it looks:
  //
  //   product   a feature with an owning team (Downloads, Bookmarks)
  //   infra     cross-cutting plumbing (Mojo, IDL) that belongs to no feature
  //   platform  flags, prefs and switches, which cut across everything
  //
  // Defining only `product` areas is the classic mistake.  Measured on
  // M148 -> M151, product areas alone left 1,802 of 2,226 findings unassigned
  // -- including all ten of the highest-severity items, which were Mojo
  // signature changes belonging to no product.  The report always prints the
  // unassigned count; treat a large one as a gap in this list, not as noise.
  //
  // Five matchers are available and any one of them claims the finding:
  //   paths    path prefixes
  //   symbols  substring match on names (keep these specific)
  //   prefs    preference key prefixes
  //   flags    feature / variable name prefixes
  //   kinds    fact kinds owned outright (mojo_method, idl_member, ...)
  // ---------------------------------------------------------------------
  areas: [
    // -- product areas ---------------------------------------------------
    {
      id: "downloads",
      title: "Downloads",
      kind: "product",
      weight: 75,
      owner: "downloads-team",
      paths: ["components/download/", "chrome/browser/download/",
              "content/browser/download/"],
      symbols: ["Download"],
      prefs: ["download."],
      flags: ["kDownload", "kParallelDownload"],
    },
    {
      id: "bookmarks",
      title: "Bookmarks",
      kind: "product",
      weight: 70,
      owner: "bookmarks-team",
      paths: ["components/bookmarks/", "chrome/browser/bookmarks/"],
      symbols: ["Bookmark"],
      prefs: ["bookmark"],
      flags: ["kBookmark"],
    },
    {
      id: "history",
      title: "History",
      kind: "product",
      weight: 70,
      owner: "history-team",
      paths: ["components/history/", "chrome/browser/history/"],
      symbols: ["History", "VisitedLink"],
      prefs: ["history"],
      flags: ["kHistory"],
    },
    {
      id: "extensions",
      title: "Extensions / add-ons",
      kind: "product",
      weight: 60,
      owner: "extensions-team",
      paths: ["extensions/", "chrome/browser/extensions/",
              "components/declarative_net_request/"],
      symbols: ["Extension", "ContentScript", "DeclarativeNetRequest"],
      flags: ["kExtension"],
    },
    {
      id: "settings",
      title: "Settings UI",
      kind: "product",
      weight: 70,
      owner: "settings-team",
      kinds: ["webui_route", "webui_control", "webui_gate"],
      paths: ["chrome/browser/resources/settings/",
              "chrome/browser/ui/webui/settings/"],
      symbols: ["Settings"],
      prefs: [],
    },
    {
      id: "media",
      title: "Video & media playback",
      kind: "product",
      weight: 90,
      owner: "media-team",
      notes: "Custom video controls, PiP, secure decode path.",
      paths: ["media/", "content/browser/media/",
              "third_party/blink/renderer/modules/mediastream/",
              "third_party/blink/renderer/modules/mediasource/"],
      symbols: ["Media", "Video", "Audio", "Codec", "PictureInPicture", "Autoplay"],
      flags: ["kMedia", "kAudio", "kVideo"],
    },
    {
      id: "privacy",
      title: "Privacy, tracking protection & ad blocking",
      kind: "product",
      weight: 85,
      owner: "privacy-team",
      paths: ["components/content_settings/", "net/cookies/",
              "components/privacy_sandbox/"],
      symbols: ["Cookie", "Tracking", "PrivacySandbox", "ThirdParty", "Fenced"],
      prefs: ["profile.content_settings", "profile.cookie"],
    },
    {
      id: "network",
      title: "Network stack",
      kind: "product",
      weight: 75,
      owner: "network-team",
      paths: ["net/", "services/network/"],
      symbols: ["Quic", "Dns", "Prefetch", "Preconnect"],
      flags: ["kHttp", "kQuic", "kDns"],
    },
    {
      id: "payments",
      title: "Samsung Pay & payments",
      kind: "product",
      weight: 85,
      owner: "payments-team",
      paths: ["components/payments/", "content/browser/payments/"],
      symbols: ["Payment", "Wallet"],
    },

    // -- infra areas: no product owns these, but they carry the most
    //    severe findings, so they need an owner of their own.
    {
      id: "ipc",
      title: "Process boundary (Mojo)",
      kind: "infra",
      weight: 80,
      owner: "platform-team",
      notes: "Mojo signature changes break silently at runtime, not at build.",
      kinds: ["mojo_method", "mojo_interface"],
    },
    {
      id: "webapi",
      title: "Web platform surface",
      kind: "infra",
      weight: 70,
      owner: "webplatform-team",
      notes: "Compatibility of the API surface our users' sites rely on.",
      kinds: ["idl_interface", "idl_member", "blink_runtime_feature"],
    },

    // -- platform area: the catch-all for configuration surface.  Listed
    //    last so more specific areas claim what they can first.
    {
      id: "flags",
      title: "Feature flags & switches",
      kind: "platform",
      weight: 40,
      owner: "release-team",
      kinds: ["flag_entry", "switch", "feature_param"],
    },
  ],

  // Trees this product never compiles.  Findings here are scored down hard.
  ignore_paths: [
    "chromeos/", "ash/", "ios/", "fuchsia/", "chrome/browser/ash/",
    "chromecast/", "remoting/",
  ],
}
